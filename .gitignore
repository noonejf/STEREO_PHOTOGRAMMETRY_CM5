# =======================================================
# Archivo .gitignore para Stereo Photogrammetry (Python/C++)
# =======================================================

# --- El Problema Principal (Archivos Grandes de Salida) ---
# Ignora los directorios que contienen resultados generados,
# como nubes de puntos, mallas, mapas de profundidad, etc.
/data/results/
/output/
/build/
/dist/

# Ignora tipos de archivo de nube de puntos y mallas,
# por si se generan en otras carpetas.
*.ply
*.pcd
*.obj
*.stl
*.bin

# --- Python ---
# Bytecode compilado
__pycache__/
*.py[cod]
*$py.class

# Entornos virtuales (Virtual environments)
/venv/
/env/
/.venv/
/.env/

# Archivos de instalación y distribución
.eggs/
*.egg-info/
*.egg
build/
dist/

# --- C/C++ (Muy común para OpenCV y performance) ---
# Archivos compilados
*.o
*.so
*.a
*.out
*.exe

# Archivos de build de CMake
/CMakeCache.txt
/CMakeFiles/
/cmake_install.cmake
/Makefile

# --- Datasets (Imágenes de entrada) ---
# DESCOMENTA las siguientes líneas si tus datasets de IMÁGENES
# de entrada también son muy grandes y no quieres subirlos.
# /data/input/
# /data/raw/
# *.png
# *.jpg
# *.jpeg
# *.bmp
# *.tif

# --- Archivos de Sistema Operativo y Editor ---
# macOS
.DS_Store
# Windows
Thumbs.db
# Linux / Editor
*.swp
*~

# --- Configuraciones de IDE ---
.vscode/
.idea/

# --- Archivos de Log y Temporales ---
*.log
*.tmp

# --- Datos capturados (pesados) ---
# Nota: data/captures/ y data/calibration/ ya tienen archivos versionados
# de antes; estas reglas solo aplican a lo nuevo.
/data/captures/

# --- Salidas de depuracion en la raiz ---
/debug_*.txt
/tracker_output.txt
/output_tracker.txt
/system_check_report.txt

# --- Backups de Blender ---
# Blender guarda el estado anterior como .blend1 cada vez que grabas.
# Son redundantes CUANDO existe el .blend hermano.
*.blend1
*.blend2
# Excepciones: estos .blend1 no tienen .blend al lado, son la unica copia
# del archivo. Si abres alguno en Blender, guardalo como .blend y borra
# la excepcion de aqui.
!SIMULATION/Simulacion_DarkBox.blend1
!SIMULATION/Untitled.blend1
!SIMULATION/Untitled_12MP.blend1

# Borat: the log is local to this machine. The memory under
# .claude/borat/memory/ is knowledge and should be committed.
.claude/borat/events.jsonl
.claude/borat/state.json

# --- Datasets sinteticos ---
# Los genera `python -m synthetic.generate`. Son decenas de miles de imagenes
# y se reconstruyen exactamente desde la semilla, asi que no tiene sentido
# versionarlas: lo que vale es el generador, no su salida.
/data/synthetic/

# El scorer de ramas entrenado. Con los valores por defecto sale en 119 MB,
# por encima del limite de 100 MB por archivo de GitHub, y demasiado grande
# para correr por paso en la CM5. Se regenera con:
#   python -m synthetic.generate path --count 2000
#   python -m synthetic.train_path --trees 60 --max-depth 10 --min-leaf 200
/data/models/path_model.pkl

# Checkpoints de entrenamiento: binarios grandes, se regeneran solos.
/data/models/*.ckpt
/data/models/endpoint_model.pkl
